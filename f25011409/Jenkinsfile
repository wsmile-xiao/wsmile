pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Install dependencies') {
            steps {
                bat 'python -m pip install -r f25011409/requirements.txt'
            }
        }
        stage('Validate Python files') {
            steps {
                bat 'python -m compileall -q f25011409/chat_cli.py f25011409/web_app.py f25011409/model_runtime.py f25011409/download_model.py'
            }
        }
        stage('Deploy') {
            when { branch 'main' }
            steps {
                echo 'Deploy stage placeholder: configure a test server and credentials before enabling deployment.'
            }
        }
    }
    post {
        always { echo 'Pipeline finished. Review stage logs before release.' }
    }
}
